    {
      "id": "stop-desktop-notify",
      "source": {
        "event": "Stop",
        "matcher": "*",
        "type": "command",
        "command": "node \"$HOME/.claude/hooks/desktop-notify.js\""
      },
      "status": "fixture-verified",
      "codex": {
        "event": "Stop",
        "matcher": "*"
      },
      "reason": "Mapped via codex-hook-dispatch's stop handler, which invokes desktop-notify.js after the stop gates pass; covered by codex-hook-dispatch.edge.test.js with a stubbed desktop-notify."
    },
    {
      "id": "stop-plan-gate",
      "source": {
        "event": "Stop",
        "matcher": "*",
        "type": "command",
        "command": "node \"$HOME/.claude/hooks/stop-gate.js\""
      },
      "status": "fixture-verified",
      "codex": {
        "event": "Stop",
        "mode": "stop"
      },
      "reason": "The ordered Stop dispatcher launches the shared gate with the native inline last_assistant_message."
    },
    {
      "id": "stop-continuation-gate",
      "source": {
        "event": "Stop",
        "matcher": "*",
