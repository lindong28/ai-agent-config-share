{
  "schemaVersion": 1,
  "authority": "claude/settings.json#hooks",
  "parityMeaning": "User-observable policy, blocking, recovery, and notification behavior; not event-name or payload byte identity.",
  "handlers": [
    {
      "id": "ask-recommend",
      "source": {
        "event": "PreToolUse",
        "matcher": "AskUserQuestion",
        "type": "command",
        "command": "node \"$HOME/.claude/hooks/ask-recommend-gate.js\""
      },
      "status": "fixture-verified",
      "codex": {
        "event": "PreToolUse",
        "matcher": "mcp__ask_user__AskUserQuestion",
        "mode": "ask"
      },
      "reason": "A real Codex call established the canonical matcher; the dispatcher normalizes it to the shared gate's AskUserQuestion name."
    },
    {
      "id": "bash-block-no-verify",
      "source": {
        "event": "PreToolUse",
        "matcher": "Bash",
        "type": "command",
        "command": "node \"$HOME/.claude/hooks/run-with-flags.js\" block-no-verify block-no-verify.js"
      },
      "status": "live-verified",
      "codex": {
        "event": "PreToolUse",
        "matcher": "Bash",
        "mode": "bash"
      },
      "reason": "A real Codex shell call was blocked before execution with the shared gate's stderr."
    },
    {
      "id": "bash-codeagent-stdin",
      "source": {
        "event": "PreToolUse",
        "matcher": "Bash",
        "type": "command",
        "command": "node \"$HOME/.claude/hooks/run-with-flags.js\" codeagent-stdin-guard codeagent-stdin-guard.js"
      },
      "status": "fixture-verified",
      "codex": {
        "event": "PreToolUse",
        "matcher": "Bash",
        "mode": "bash"
      },
      "reason": "Codex canonical Bash payload uses the same tool_input.command contract."
    },
    {
      "id": "writer-registry",
      "source": {
        "event": "PreToolUse",
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "type": "command",
        "command": "node \"$HOME/.claude/hooks/run-with-flags.js\" writer-registry-gate writer-registry-gate.js"
      },
      "status": "fixture-verified",
      "codex": {
        "event": "PreToolUse",
        "matcher": "apply_patch",
        "mode": "writer"
      },
      "reason": "The shared writer registry extracts Codex apply_patch targets from tool_input.command, keeping one path parser for both harnesses."
    },
    {
      "id": "memory-carrier-gate",
      "source": {
        "event": "PreToolUse",
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "type": "command",
        "command": "node \"$HOME/.claude/hooks/run-with-flags.js\" memory-carrier-gate memory-carrier-gate.js"
      },
      "status": "harness-specific-excluded",
      "reason": "The gate intercepts writes to Claude's file-based auto-memory directory (~/.claude/projects/*/memory), a Claude-only feature; Codex uses its built-in memories and never writes that path."
    },
