        "matcher": "*",
        "type": "command",
        "command": "node \"$HOME/.claude/hooks/teammate-reclaim-check.js\""
      },
      "status": "harness-specific-excluded",
      "reason": "The hook parses Claude teammate mailbox records and calls Claude lifecycle tools; Codex collaboration lifecycle is tracked by SubagentStart/SubagentStop and remains caller-owned."
    },
    {
      "id": "sessionstart-teammate-reclaim",
      "source": {
        "event": "SessionStart",
        "matcher": "startup|resume",
        "type": "command",
        "command": "node \"$HOME/.claude/hooks/teammate-reclaim-check.js\""
      },
      "status": "harness-specific-excluded",
      "reason": "The hook consumes Claude teammate mailbox/transcript records; Codex active-agent state is maintained from native SubagentStart/SubagentStop instead."
