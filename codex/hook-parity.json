        "command": "node \"$HOME/.claude/hooks/stop-gate.js\""
      },
      "status": "fixture-verified",
      "codex": {
        "event": "SubagentStop",
        "mode": "subagent-stop"
      },
      "reason": "Codex exposes SubagentStop; the dispatcher removes lifecycle state only after the shared gate allows the stop."
